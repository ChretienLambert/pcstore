{
    "version": 2,
    "name": "backend",
    "builds": [
      { "src": "server.js",
        "use": "@vercel/node" 
        }
    ],
    "routes": [
      { "src": "/api/(.*)", "dest": "server.js" },
      { "src": "/api", "dest": "server.js" },
      { "src": "^/$", "dest": "server.js" },
      { "src": "^/favicon.png$", "dest": "server.js" },
      { "src": "^/favicon.ico$", "dest": "server.js" }
    ]
}